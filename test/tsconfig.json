{
  // Unit tests run under plain vitest (no Nuxt environment), but import code from app/ and
  // server/, so they borrow the app config for `#app` paths, plus `nuxt.d.ts` for the app and
  // Nitro auto-import globals (server routes are pulled in via `$fetch` typing), the Cloudflare
  // binding types from `worker-configuration.d.ts`, and Node's types for the `node:*` modules
  // the test doubles use.
  "extends": "../.nuxt/tsconfig.app.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["../.nuxt/nuxt.d.ts", "../worker-configuration.d.ts", "./**/*.ts", "../vitest.config.ts"]
}
