  "devDependencies": {
    "@anthropic-ai/claude-code": "^2.1.308",
    "@catppuccin/daisyui": "^2.1.1",
    "@catppuccin/tailwindcss": "^1.0.0",
    "@iconify-json/grommet-icons": "^1.2.4",
    "@storybloq/storybloq": "^1.15.9",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.6.5",
    "ctx7": "^0.8.1",
    "drizzle-kit": "^0.31.11",
    "lefthook": "^2.2.2",
    "nitropack": "^2.13.5",
    "npm-run-all2": "^9.0.4",
    "nuxi": "^4.0.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "untun": "^0.2.2",
    "vite-plugin-eslint2": "^5.3.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": "^26.12.0"
  },
  "name": "syn-horse",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/synmux/syn-horse.git"
  },
  "scripts": {
    "build": "pnpm run-s build:nuxt types",
    "build:nuxt": "pnpm nuxt build",
    "db:generate": "pnpm drizzle-kit generate",
    "db:migrate:local": "pnpm wrangler d1 migrations apply syn-horse --local --config wrangler.dev.jsonc",
    "db:migrate:remote": "pnpm wrangler d1 migrations apply syn-horse --remote --config wrangler.dev.jsonc",
    "db:studio": "pnpm drizzle-kit studio",
    "deploy": "pnpm run-s deploy:stamp deploy:hash deploy:wrangler",
    "deploy:hash": "git rev-parse --short HEAD > .commithash",
    "deploy:nonprod": "pnpm run-s deploy:stamp deploy:hash build deploy:nonprod:wrangler",
    "deploy:nonprod:wrangler": "pnpm wrangler versions upload",
    "deploy:stamp": "date -u +%FT%TZ > .buildtime",
    "deploy:wrangler": "pnpm wrangler deploy",
    "dev": "pnpm nuxt dev",
    "format": "pnpm run-s format:prettier format:trunk",
    "format:prettier": "pnpm prettier --write .",
    "format:trunk": "pnpm trunk fmt -a",
    "generate": "pnpm nuxt generate",
    "lint": "pnpm run-s lint:eslint lint:trunk lint:types",
    "lint:eslint": "pnpm eslint .",
    "lint:eslint:fix": "pnpm eslint . --fix",
    "lint:fix": "pnpm run-s lint:eslint:fix lint:trunk:fix",
    "lint:trunk": "pnpm trunk check -a",
    "lint:trunk:fix": "pnpm trunk check -a --fix",
    "lint:types": "pnpm nuxt typecheck",
    "postinstall": "pnpm prepare",
    "prepare": "pnpm run-s prepare:nuxt",
    "prepare:nuxt": "pnpm nuxt prepare",
    "preview": "pnpm run-s build preview:wrangler",
    "preview:wrangler": "pnpm wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "pnpm run-s prepare:nuxt types:wrangler",
    "types:wrangler": "pnpm wrangler types --config .output/server/wrangler.json"
  },
  "type": "module",
  "packageManager": "pnpm@12.4.1"
}
