{
  "name": "syn-horse-notifications",
  "version": "0.0.0-dev.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/synmux/syn-horse.git",
    "branch": "notifications"
  },
  "author": {
    "name": "syn",
    "email": "syn@syn.as",
    "url": "https://github.com/synmux"
  },
  "type": "module",
  "scripts": {
    "db:migrate": "wrangler d1 migrations apply syn-horse-notifications --remote",
    "db:migrate:local": "wrangler d1 migrations apply syn-horse-notifications --local",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "doctor:ultracite": "ultracite doctor",
    "fix": "ultracite fix",
    "fix:unsafe": "ultracite fix --unsafe",
    "format": "biome format --write .",
    "postinstall": "pnpm run types",
    "lint": "run-s lint:ultracite lint:types",
    "lint:types": "tsc --noEmit",
    "lint:ultracite": "ultracite check",
    "prepare": "skilld prepare || true",
    "start": "pnpm run dev",
    "types": "wrangler types"
  },
  "dependencies": {
    "ntfy": "^1.15.3",
    "pushover-js": "^1.3.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "^2.1.263",
    "@biomejs/biome": "^2.5.12",
    "@cloudflare/vitest-pool-workers": "^0.16.20",
    "@types/node": "^24.13.3",
    "ctx7": "^0.4.5",
    "npm-run-all2": "^9.0.3",
    "skilld": "^2.3.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "ultracite": "^7.11.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  },
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "engines": {
    "node": "^24.20.0"
  }
}
