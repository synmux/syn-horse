# .npmrc - reference only. nothing in here is active.
#
# pnpm 11+ reads only auth and registry settings from .npmrc. every other key
# lives in pnpm-workspace.yaml with camelCase names. the ini spellings below
# are the .npmrc equivalents of the install settings in pnpm-workspace.yaml,
# kept commented so the alternative can be reviewed. verified with pnpm 12.4.1:
# uncommenting them has no effect (`pnpm config get child-concurrency` stays
# empty and no warning is printed), so do not expect them to work here.
#
# install behaviour (bunfig.toml `[install]` -> pnpm)
#
# auto-install-peers=true  # install.peer (closest match; pnpm default)
# child-concurrency=16     # install.concurrentScripts
#
# not carried over: optional / dev / production (no longer pnpm settings;
# `--prod` and `--dev` are cli flags only), save-text-lockfile (no
# equivalent, the lockfile is always yaml), frozen-lockfile (leave pnpm's
# ci-aware default alone), dry-run (cli flag only).
